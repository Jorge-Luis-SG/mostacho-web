---
import Img from '../ui/Img.astro';
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import type { LandingContext } from '../../lib/context';

interface Props {
  ctx: LandingContext;
}

const { ctx } = Astro.props;
const { config, t, ui } = ctx;
const items = config.nav.map((id) => ({ href: `#${id}`, label: t.nav[id] as string }));
---

<header class="header" data-header>
  <div class="header__bar">
    <a href={`#${config.sections[0]?.id ?? ''}`} class="header__logo" aria-label={ui.home}>
      <Img site={ctx.site} src={config.logo} alt={ui.logoAlt} sizes="130px" priority maxWidth={480} />
    </a>

    <button
      type="button"
      class="header__toggle"
      aria-expanded="false"
      aria-controls="main-nav"
      data-nav-toggle
    >
      <span class="sr-only" data-label-open>{ui.menuOpen}</span>
      <span class="sr-only" data-label-close hidden>{ui.menuClose}</span>
      <Icon name="menu" size={30} class="icon-open" />
      <Icon name="close" size={30} class="icon-close" />
    </button>

    <nav id="main-nav" class="header__nav" aria-label={ui.mainNav} data-nav>
      <ul role="list">
        {items.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <Button href={ctx.whatsapp} variant="whatsapp" size="lg" class="header__cta">
      <Img slot="icon" site={ctx.site} src={config.ctaIcon ?? 'icon-whatsapp-black.png'} alt="" sizes="50px" maxWidth={100} optional />
      {ui.contact}
    </Button>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const setOpen = (open: boolean) => {
    if (!header || !toggle) return;
    header.toggleAttribute('data-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.querySelector<HTMLElement>('[data-label-open]')!.hidden = open;
    toggle.querySelector<HTMLElement>('[data-label-close]')!.hidden = !open;
  };
  toggle?.addEventListener('click', () => setOpen(!header!.hasAttribute('data-open')));
  header?.querySelectorAll('[data-nav] a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
</script>

<style>
  .header :global(.header__cta) {
    width: var(--cta-w);
    min-height: calc(clamp(4.8rem, calc(4.7 * var(--u)), 9rem) - 0.4rem);
    padding: 0.4em 1em 0.4em 0.6em;
    justify-content: center;
    gap: 0.8em;
  }
  .header {
    position: absolute;
    inset: 0 0 auto;
    z-index: 20;
    /* Menos margen a los lados que el resto de la página: la cabecera se ve más ancha */
    --header-side: calc(max(0px, (100vw - 1920px) / 2) + clamp(1.6rem, calc(2.5 * var(--vw)), 4.8rem));
    padding: clamp(1rem, calc(0.94 * var(--u)), 1.8rem) var(--header-side) 0;
  }
  .header__bar {
    --logo-w: clamp(6rem, calc(6.6 * var(--u)), 12.6rem);
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(0.6rem, calc(0.62 * var(--u)), 1.2rem);
  }
  /* El logo va 10 px más abajo y por encima de la barra del menú, que empieza por detrás de él */
  .header__logo { position: relative; z-index: 2; display: block; width: var(--logo-w); top: 1rem; }
  .header__logo :global(img), .header__logo :global(.img-missing) { width: 100%; height: auto; aspect-ratio: 126 / 132; object-fit: contain; }

  .header__nav {
    /* Efecto cristal del diseño (solo aquí: es un elemento pequeño y se va al hacer scroll) */
    backdrop-filter: blur(22px) saturate(1.3);
    -webkit-backdrop-filter: blur(22px) saturate(1.3);
    /* La barra arranca por detrás del logo (pegada a él) y su texto empieza después */
    margin-left: calc(-0.6 * var(--logo-w) - clamp(0.6rem, calc(0.62 * var(--u)), 1.2rem));
    padding-left: calc(0.6 * var(--logo-w));
    border-radius: var(--radius-pill);
    background: var(--color-glass);
  }
  .header__nav ul {
    display: flex;
    justify-content: space-between;
    gap: clamp(0.8rem, calc(1.2 * var(--u)), 2.4rem);
    min-height: clamp(4.8rem, calc(4.7 * var(--u)), 9rem);
    align-items: center;
    padding: 0.5rem clamp(1.6rem, calc(3 * var(--u)), 5.8rem) 0.5rem clamp(1.6rem, calc(3.4 * var(--u)), 6.5rem);
    margin: 0;
  }
  .header__nav a {
    display: block;
    padding: 0.5rem 0.25rem;
    font-family: var(--font-heading);
    font-weight: var(--heading-weight);
    font-size: var(--size-nav);
    text-transform: var(--heading-transform);
    white-space: nowrap;
    transition: color 0.15s ease;
  }
  .header__nav a:hover { color: var(--color-primary); }

  .header__toggle {
    display: none;
    place-items: center;
    width: 4.8rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-glass);
  }
  .header__toggle :global(.icon-close) { display: none; }

  @media (max-width: 1200px) {
    .header__bar { grid-template-columns: auto 1fr auto auto; }
    .header__toggle { display: grid; grid-column: 3; }
    .header :global(.header__cta) { grid-column: 4; grid-row: 1; width: auto; }
    .header__nav {
    /* Efecto cristal del diseño (solo aquí: es un elemento pequeño y se va al hacer scroll) */
    backdrop-filter: blur(22px) saturate(1.3);
    -webkit-backdrop-filter: blur(22px) saturate(1.3);
      display: none;
      grid-column: 1 / -1;
      margin: 0;
      padding: 0;
      border-radius: var(--radius-lg);
    }
    .header__nav ul { flex-direction: column; align-items: stretch; padding: 1rem 1.5rem; }
    .header__nav a { padding: 0.9rem 0.5rem; white-space: normal; }
    .header[data-open] .header__nav { display: block; }
    .header[data-open] .header__toggle :global(.icon-open) { display: none; }
    .header[data-open] .header__toggle :global(.icon-close) { display: block; }
  }
  @media (max-width: 640px) {
    .header :global(.header__cta span) { display: none; }
    .header :global(.header__cta) { padding: 0.6rem; min-height: 0; }
  }
</style>
