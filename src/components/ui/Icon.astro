---
/** Iconos SVG en línea (heredan el color del texto con currentColor). */
interface Props {
  name: 'youtube' | 'facebook' | 'instagram' | 'whatsapp' | 'tiktok' | 'arrow-left' | 'arrow-right' | 'arrow-down' | 'chevron-left' | 'chevron-right' | 'menu' | 'close' | 'star' | 'sound-on' | 'sound-off';
  size?: number | string;
  class?: string;
}
const { name, size = 24, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {name === 'youtube' && (
    <path
      fill="currentColor"
      stroke="none"
      fill-rule="evenodd"
      d="M2 8.6A3.6 3.6 0 0 1 5.6 5h12.8A3.6 3.6 0 0 1 22 8.6v6.8a3.6 3.6 0 0 1-3.6 3.6H5.6A3.6 3.6 0 0 1 2 15.4zM10 9v6l5.2-3z"
    />
  )}
  {name === 'facebook' && (
    <path
      fill="currentColor"
      stroke="none"
      d="M12 2C6.48 2 2 6.48 2 12c0 4.99 3.66 9.13 8.44 9.88v-6.99H7.9V12h2.54V9.8c0-2.51 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99C18.34 21.13 22 16.99 22 12c0-5.52-4.48-10-10-10z"
    />
  )}
  {name === 'instagram' && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="5" stroke-width="2" />
      <circle cx="12" cy="12" r="4" stroke-width="2" />
      <circle cx="17.3" cy="6.7" r="1.1" fill="currentColor" stroke="none" />
    </>
  )}
  {name === 'whatsapp' && (
    <>
      <path stroke-width="1.8" d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3z" />
      <path
        fill="currentColor"
        stroke="none"
        d="M8.7 7.6c.2-.4.4-.4.7-.4h.5c.2 0 .4 0 .6.5l.7 1.7c.1.2.1.4 0 .6l-.4.6c-.1.2-.2.3 0 .5.5.9 1.5 1.8 2.4 2.3.3.1.4.1.5-.1l.6-.7c.2-.2.3-.2.5-.1l1.7.8c.2.1.4.2.4.4 0 .5-.2 1.3-.8 1.7-.6.4-1.3.5-2.3.2-1.5-.5-3-1.5-4.2-3-.9-1.2-1.4-2.2-1.4-3.1 0-.8.3-1.4.5-1.7z"
      />
    </>
  )}
  {name === 'tiktok' && (
    <path
      fill="currentColor"
      stroke="none"
      d="M16.6 3c.3 2 1.6 3.4 3.4 3.6v3a7 7 0 0 1-3.4-1v6.2A5.8 5.8 0 1 1 10.8 9v3.1a2.8 2.8 0 1 0 2.8 2.8V3z"
    />
  )}
  {name === 'arrow-left' && <path d="M20 12H4m6-6-6 6 6 6" />}
  {name === 'arrow-right' && <path d="M4 12h16m-6-6 6 6-6 6" />}
  {name === 'arrow-down' && <path d="M12 4v16m-6-6 6 6 6-6" />}
  {name === 'chevron-right' && <path d="m9 4 8 8-8 8" />}
  {name === 'chevron-left' && <path d="m15 4-8 8 8 8" />}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" stroke-width="2" />}
  {name === 'sound-on' && <path d="M4 9v6h4l5 4V5L8 9H4Zm12.5-.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12" />}
  {name === 'sound-off' && <path d="M4 9v6h4l5 4V5L8 9H4Zm12 .5 5 5m0-5-5 5" />}
  {name === 'close' && <path d="M6 6l12 12M18 6 6 18" stroke-width="2" />}
  {name === 'star' && (
    <path
      fill="currentColor"
      stroke="none"
      d="m12 2.8 2.8 5.8 6.3.8-4.6 4.4 1.1 6.3L12 17.1l-5.6 3 1.1-6.3-4.6-4.4 6.3-.8z"
    />
  )}
</svg>
