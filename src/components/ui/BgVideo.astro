---
/**
 * Video de fondo (en bucle) que se pone encima de su imagen.
 * La imagen sigue debajo como póster: si el video no carga, no está o el visitante
 * prefiere menos movimiento / ahorro de datos, se ve la foto.
 * Normalmente va sin sonido; con hover + sound, el sonido entra poco a poco al pasar el ratón
 * (en pantallas táctiles, al tocar la tarjeta: lleva un botón de «play» para que se note).
 */
import { resolveVideo } from '../../lib/images';

interface Props {
  site: string;
  src?: string;
  class?: string;
  /** Solo en pantallas grandes (en móvil se queda la foto para ahorrar datos). */
  desktopOnly?: boolean;
  /** Versión ligera para móviles y tablets en vertical (opcional). */
  srcSmall?: string;
  /** Solo se reproduce mientras el ratón está sobre su contenedor; en reposo (y en pantallas táctiles) se ve la foto. */
  hover?: boolean;
  /** Con hover: se escucha mientras el ratón está encima (el volumen sube poco a poco y baja al salir). */
  sound?: boolean;
}
const { site, src, class: className, desktopOnly = false, srcSmall, hover = false, sound = false } = Astro.props;
const url = resolveVideo(site, src);
const urlSmall = resolveVideo(site, srcSmall);
---

{
  url && (
    <video
      class:list={['bg-video', className]}
      data-src={url}
      data-src-small={urlSmall}
      data-desktop-only={desktopOnly ? '' : undefined}
      data-hover={hover ? '' : undefined}
      data-sound={hover && sound ? '' : undefined}
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
      tabindex="-1"
    />
  )
}
{url && hover && <span class="bg-video__tap" aria-hidden="true" />}

<script>
  const quiet =
    window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
    // @ts-expect-error: API no estándar (Chrome/Android)
    navigator.connection?.saveData === true;
  // Pantallas en vertical o pequeñas: versión ligera (data-src-small) si la hay
  const small = window.matchMedia('(max-width: 900px), (max-aspect-ratio: 1/1)').matches;
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const videos = [...document.querySelectorAll<HTMLVideoElement>('video.bg-video')];
  const promos = [...document.querySelectorAll<HTMLElement>('[data-promo]')];
  const visible = new Set<HTMLVideoElement>();
  const starting = new WeakSet<HTMLVideoElement>();
  // La foto del inicio permanece visible mientras la promoción está pendiente o abierta.
  // Su video no compite por la conexión ni reproduce debajo de una ventana que lo tapa.
  const eligible = (video: HTMLVideoElement) => {
    if (quiet || document.hidden || (video.hasAttribute('data-desktop-only') && innerWidth < 768)) return false;
    const promo = video.closest<HTMLElement>('[data-promo]');
    return promo ? !promo.hidden && !promo.hasAttribute('data-dismissed') : !promos.some((p) => !p.hasAttribute('data-dismissed'));
  };
  const wanted = (video: HTMLVideoElement) => eligible(video) && !video.closest('.is-off') && (
    video.hasAttribute('data-hover')
      ? finePointer ? hovered === video && !!video.parentElement?.matches(':hover') : active === video
      : visible.has(video)
  );

  // Si el navegador no deja reproducir solo (ahorro de batería, ajustes de reproducción automática…),
  // se reintenta en cuanto el visitante toca, hace scroll o pulsa una tecla
  const blocked = new Set<HTMLVideoElement>();
  const retry = () => blocked.forEach((v) => start(v));
  ['pointerdown', 'touchstart', 'keydown', 'scroll'].forEach((ev) => window.addEventListener(ev, retry, { passive: true }));

  const start = (video: HTMLVideoElement) => {
    if (!wanted(video) || starting.has(video)) return;
    if (!video.src) video.src = (small && video.dataset.srcSmall) || video.dataset.src!;
    // Sin sonido: imprescindible para que el navegador permita reproducirlo solo (los que suenan solo se activan
    // si el navegador ya lo permite; ver soundOn)
    if (!video.hasAttribute('data-sound')) video.muted = true;
    starting.add(video);
    video
      .play()
      .then(() => {
        blocked.delete(video);
        if (!wanted(video)) { video.pause(); return; }
        video.classList.add('is-playing');
      })
      .catch(() => { if (wanted(video)) blocked.add(video); })
      .finally(() => starting.delete(video));
  };

  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      const video = e.target as HTMLVideoElement;
      if (e.isIntersecting) { visible.add(video); start(video); }
      else {
        visible.delete(video);
        blocked.delete(video);
        video.pause();
      }
    }
  }, { rootMargin: '200px' });

  // Volumen que sube o baja poco a poco (sin golpes de sonido)
  const ramps = new WeakMap<HTMLVideoElement, number>();
  const fades = new WeakMap<HTMLVideoElement, number>();
  const cancelFade = (video: HTMLVideoElement) => {
    cancelAnimationFrame(ramps.get(video) ?? 0);
    clearTimeout(fades.get(video));
    ramps.delete(video);
    fades.delete(video);
  };
  const fadeVolume = (video: HTMLVideoElement, to: number, ms: number, done?: () => void) => {
    cancelFade(video);
    const from = video.volume;
    // Los videos en silencio solo necesitan esperar al fundido CSS, sin ejecutar un RAF por fotograma.
    if (video.muted || from === to) {
      if (done) fades.set(video, window.setTimeout(() => { fades.delete(video); done(); }, ms));
      return;
    }
    const t0 = performance.now();
    const tick = (now: number) => {
      const k = Math.min(1, (now - t0) / ms);
      // Al subir empieza muy bajito y acelera; al bajar, al revés
      video.volume = Math.min(1, Math.max(0, from + (to - from) * (to > from ? k * k : 1 - (1 - k) * (1 - k))));
      if (k < 1) ramps.set(video, requestAnimationFrame(tick));
      else done?.();
    };
    ramps.set(video, requestAnimationFrame(tick));
  };

  // El navegador solo deja que suene un video si el visitante ya tocó la página (clic, tecla…):
  // hasta entonces se ve en silencio, y si hace clic con el ratón encima, el sonido entra en ese momento
  const canSound = () => (navigator as Navigator & { userActivation?: { hasBeenActive: boolean } }).userActivation?.hasBeenActive ?? true;
  let hovered: HTMLVideoElement | null = null;
  const soundOn = (video: HTMLVideoElement) => {
    if (!video.hasAttribute('data-sound') || !canSound()) return;
    if (video.muted) {
      video.volume = 0;
      video.muted = false;
    }
    fadeVolume(video, 1, 2200);
  };
  ['pointerdown', 'keydown'].forEach((ev) => window.addEventListener(ev, () => hovered && requestAnimationFrame(() => hovered && soundOn(hovered)), { passive: true }));

  // Al pasar el ratón por el contenedor (la tarjeta) se reproduce; al salir se funde de vuelta a la foto.
  // Cuando la tarjeta se acerca se prepara la cabecera del video después de la carga inicial.
  // La descarga completa se solicita al entrar en esa tarjeta, sin cargar los otros videos del carrusel.
  // Sin ratón (pantallas táctiles), ver tapVideo.
  const nearby = new Set<HTMLVideoElement>();
  const prime = (video: HTMLVideoElement) => {
    if (document.readyState !== 'complete' || !eligible(video)) return;
    near.unobserve(video);
    nearby.delete(video);
    if (!video.src) {
      video.preload = 'metadata';
      video.src = (small && video.dataset.srcSmall) || video.dataset.src!;
    }
  };
  const near = new IntersectionObserver((entries) => {
    for (const e of entries) {
      const video = e.target as HTMLVideoElement;
      if (!e.isIntersecting) { nearby.delete(video); continue; }
      nearby.add(video);
      prime(video);
    }
  }, { rootMargin: '400px' });
  const hoverVideo = (video: HTMLVideoElement) => {
    const zone = video.parentElement;
    if (!zone) return;
    near.observe(video);
    if (!finePointer) return tapVideo(video, zone);
    zone.addEventListener('pointerenter', () => {
      hovered = video;
      cancelFade(video); // si se estaba yendo, se queda
      video.preload = 'auto';
      start(video);
      soundOn(video);
    });
    // Al salir, el video sigue moviéndose mientras se desvanece (y su sonido baja); se pausa al terminar
    zone.addEventListener('pointerleave', () => {
      if (hovered === video) hovered = null;
      blocked.delete(video);
      video.classList.remove('is-playing');
      fadeVolume(video, 0, 900, () => {
        video.pause();
        video.muted = true;
      });
    });
  };

  // Pantallas táctiles: al tocar la tarjeta (fuera de su botón) se reproduce con el sonido entrando poco a poco;
  // al volver a tocarla, al tocar otra o al salir de la pantalla, se funde de vuelta a la foto
  let active: HTMLVideoElement | null = null;
  const stop = (video: HTMLVideoElement) => {
    if (active === video) active = null;
    video.classList.remove('is-playing');
    fadeVolume(video, 0, 700, () => {
      video.pause();
      video.muted = true;
    });
  };
  const offscreen = new IntersectionObserver((entries) => {
    for (const e of entries) if (!e.isIntersecting && active === e.target) stop(e.target as HTMLVideoElement);
  });
  const tapVideo = (video: HTMLVideoElement, zone: HTMLElement) => {
    offscreen.observe(video);
    zone.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a, button')) return;
      if (active === video) return stop(video);
      if (active) stop(active);
      active = video;
      if (!video.src) video.src = video.dataset.src!;
      video.preload = 'auto';
      cancelFade(video);
      // play() va dentro del toque: así el navegador deja que suene
      const sound = video.hasAttribute('data-sound');
      video.muted = !sound;
      video.volume = 0;
      const shown = () => {
        if (!wanted(video)) { video.pause(); return; }
        video.classList.add('is-playing');
        if (sound && !video.muted) fadeVolume(video, 1, 2200);
      };
      video.play().then(shown, () => {
        // Si no deja con sonido, al menos se ve
        video.muted = true;
        video.play().then(shown, () => {});
      });
    });
  };

  // Los videos empiezan a descargarse cuando la página ya cargó y el navegador está libre,
  // para no competir con las fotos y el texto (el del inicio, en cuanto carga la página).
  // Los de las tarjetas responden al ratón o al dedo desde el primer momento (solo su descarga espera a acercarse)
  const init = () => {
    nearby.forEach(prime);
    document.querySelectorAll<HTMLVideoElement>('video.bg-video:not([data-hover])').forEach((video) => {
      if (!video.closest('[data-promo]')) io.observe(video);
    });
  };
  // El video de la ventana visible sí es prioritario; el fondo de la página espera a la carga inicial.
  if (!quiet) promos.forEach((promo) => promo.querySelectorAll<HTMLVideoElement>('video.bg-video').forEach((video) => io.observe(video)));
  if (!quiet) document.querySelectorAll<HTMLVideoElement>('video.bg-video[data-hover]').forEach(hoverVideo);
  const whenIdle = () => ('requestIdleCallback' in window ? requestIdleCallback(init, { timeout: 800 }) : setTimeout(init, 200));
  if (!quiet) {
    if (document.readyState === 'complete') whenIdle();
    else window.addEventListener('load', whenIdle, { once: true });
  }
  const refresh = () => {
    nearby.forEach(prime);
    videos.forEach((video) => {
      if (wanted(video)) start(video);
      else {
        blocked.delete(video);
        if (document.hidden) cancelFade(video);
        video.pause();
      }
    });
  };
  document.addEventListener('visibilitychange', refresh);
  document.addEventListener('promo:change', refresh);
  matchMedia('(min-width: 768px)').addEventListener('change', refresh);
</script>

<style>
  .bg-video {
    opacity: 0;
    transition: opacity 0.6s ease;
    object-fit: cover;
    pointer-events: none;
  }
  .bg-video:global(.is-playing) { opacity: 1; }
  /* Videos de «pasar el ratón» (tarjetas): fundido más lento y suave entre la foto y el video */
  .bg-video[data-hover] { transition: opacity 0.9s cubic-bezier(0.45, 0, 0.25, 1); }
  /* Botón de «play» de las tarjetas con video, solo en pantallas táctiles; se va mientras el video se ve */
  .bg-video__tap { display: none; }
  @media not ((hover: hover) and (pointer: fine)) {
    .bg-video__tap {
      display: grid;
      place-items: center;
      position: absolute;
      top: 1.4rem;
      right: 1.4rem;
      z-index: 1;
      width: 4.4rem;
      aspect-ratio: 1;
      border-radius: 50%;
      background: rgb(0 0 0 / 0.45);
      border: 1px solid rgb(255 255 255 / 0.5);
      -webkit-backdrop-filter: blur(6px);
      backdrop-filter: blur(6px);
      pointer-events: none;
      transition: opacity 0.4s ease, transform 0.4s ease;
    }
    .bg-video__tap::before {
      content: '';
      margin-left: 0.3rem;
      border-style: solid;
      border-width: 0.8rem 0 0.8rem 1.3rem;
      border-color: transparent transparent transparent #fff;
    }
    .bg-video:global(.is-playing) + .bg-video__tap { opacity: 0; transform: scale(0.8); }
  }
</style>
