---
interface Props {
  links: { lang: string; label: string; href: string; current: boolean }[];
  label: string;
  class?: string;
}
const { links, label, class: className } = Astro.props;
---

<nav class:list={['lang', className]} aria-label={label}>
  {
    links.map((l) => (
      <a href={l.href} hreflang={l.lang} lang={l.lang} aria-current={l.current ? 'true' : undefined}>
        {l.label}
      </a>
    ))
  }
</nav>

<style>
  .lang { display: flex; align-items: stretch; font-family: var(--font-ui); font-size: var(--size-lang); line-height: 1; }
  a { padding: 0.55em 0.9em; color: var(--color-text-muted); transition: color 0.15s ease; }
  a + a { border-left: 1px solid var(--color-divider); }
  a:last-child { padding-right: 0; }
  a:hover, a[aria-current='true'] { color: var(--color-text); }
</style>
