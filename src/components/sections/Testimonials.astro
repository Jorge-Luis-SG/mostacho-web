---
import SectionShell from '../layout/SectionShell.astro';
import SectionTitle from '../ui/SectionTitle.astro';
import Carousel from '../ui/Carousel.astro';
import Img from '../ui/Img.astro';
import Icon from '../ui/Icon.astro';
import { fill } from '../../lib/i18n';
import type { TestimonialsSection } from '../../lib/types';
import type { LandingContext } from '../../lib/context';

interface Props {
  section: TestimonialsSection;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  text: Record<string, any>;
  ctx: LandingContext;
}
const { section, text, ctx } = Astro.props;
const { ui } = ctx;
const titleId = `${section.id}-title`;
const initials = (name: string) =>
  name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0]!.toUpperCase())
    .join('');
---

<SectionShell id={section.id} site={ctx.site} space={section.space} background={section.background} decor={section.decor} labelledby={titleId} class="testimonials-shell" anim={section.anim} count={section.items.length}>
  <SectionTitle id={titleId} text={text.title} variant={section.titleStyle ?? 'plain'} size={section.titleSize} />
  <div class="testimonials">
    <Carousel label={text.title} variant="testimonials" ui={ui.carousel}>
      {
        section.items.map((item) => {
          const tx = text.items[item.id];
          return item.kind === 'review' ? (
            <blockquote class="review">
              <header class="review__head">
                {item.avatar ? (
                  <Img site={ctx.site} src={item.avatar} alt="" class="review__avatar" sizes="64px" optional maxWidth={480} />
                ) : (
                  <span class="review__initials" aria-hidden="true">{initials(tx.name)}</span>
                )}
                <div>
                  <cite>{tx.name}</cite>
                  {tx.meta && <p class="review__meta">{tx.meta}</p>}
                </div>
              </header>
              <div class="review__rating">
                {item.rating ? (
                  <span class="review__stars" role="img" aria-label={fill(ui.rating, { n: item.rating })}>
                    {Array.from({ length: 5 }, (_, i) => (
                      <Icon name="star" size={26} class={i < (item.rating ?? 0) ? 'on' : 'off'} />
                    ))}
                  </span>
                ) : (
                  item.platform === 'instagram' && <Icon name="instagram" size={24} class="review__platform" />
                )}
                {tx.time && <span class="review__meta">{tx.time}</span>}
              </div>
              <p class="review__text">{tx.text}</p>
            </blockquote>
          ) : (
            <figure class="shot">
              <Img site={ctx.site} src={item.image} alt={tx.alt} sizes="(max-width: 800px) 88vw, 740px" maxWidth={1440} />
            </figure>
          );
        })
      }
    </Carousel>
  </div>
</SectionShell>

<style>
  :global(section.shell.testimonials-shell) { padding-top: clamp(5rem, calc(6.4 * var(--u)), 12.4rem); padding-bottom: clamp(5rem, calc(8 * var(--u)), 15.5rem); }
  .testimonials {
    margin-top: clamp(2.4rem, calc(3.2 * var(--u)), 6rem);
    width: min(100%, var(--layout-testimonials));
    margin-inline: auto;
    --carousel-gap: clamp(1rem, calc(1.35 * var(--u)), 2.6rem);
    --carousel-arrow-offset: clamp(6rem, calc(5.6 * var(--u)), 10.7rem);
  }
  .testimonials :global(.carousel__track) { grid-auto-columns: calc((100% - var(--carousel-gap)) / 2); }
  @media (max-width: 900px) {
    .testimonials :global(.carousel__track) { align-items: start; }
  }
  @media (max-width: 800px) {
    .testimonials :global(.carousel__track) { grid-auto-columns: 92%; }
  }

  .review, .shot {
    min-height: clamp(30rem, calc(21.9 * var(--u)), 42rem); /* 736×420 en el diseño; crece si la reseña es larga */
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .review {
    padding: clamp(2.4rem, calc(4.1 * var(--u)), 7.9rem) clamp(2rem, calc(1.6 * var(--u)), 3.1rem) 2rem;
    background: var(--color-review-bg);
    color: var(--color-review-text);
    font-family: var(--font-ui);
  }
  .review__head { display: flex; align-items: center; gap: clamp(1rem, calc(1.25 * var(--u)), 2.4rem); }
  .review__head :global(.review__avatar) { width: clamp(4rem, calc(3.23 * var(--u)), 6.2rem); aspect-ratio: 1; height: auto; border-radius: 50%; object-fit: cover; }
  .review__initials {
    display: grid;
    place-items: center;
    flex: none;
    width: clamp(4rem, calc(3.23 * var(--u)), 6.2rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-primary);
    color: var(--color-primary-contrast);
    font-weight: 700;
    font-size: clamp(1.5rem, calc(1.1 * var(--u)), 2.1rem);
  }
  .review__rating :global(.review__platform) { color: #c13584; }
  cite { font-style: normal; font-size: var(--size-review); line-height: 1.2; color: #202124; }
  .review__meta { color: var(--color-review-muted); font-size: var(--size-review-meta); line-height: 1.3; }
  .review__rating { display: flex; align-items: center; gap: clamp(1rem, calc(1 * var(--u)), 2rem); margin-top: clamp(1.4rem, calc(1.8 * var(--u)), 3.4rem); }
  .review__stars { display: flex; gap: 0.1rem; }
  .review__stars :global(.on) { color: var(--color-star); }
  .review__stars :global(.off) { color: var(--color-review-muted); opacity: 0.4; }
  .review__text { margin-top: clamp(1.2rem, calc(1.25 * var(--u)), 2.4rem); font-size: var(--size-review); line-height: 1.4; }

  .shot { background: var(--color-shot-bg); display: grid; place-items: center; }
  .shot :global(img), .shot :global(.img-missing) { width: 100%; height: 100%; object-fit: contain; }
  @media (max-width: 800px) {
    .review, .shot { aspect-ratio: auto; min-height: 30rem; }
  }
</style>
