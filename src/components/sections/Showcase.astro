---
/** Título + diapositivas a ancho completo (Hora loca, Recibe a tus invitados, Fiestas infantiles…). */
import SectionShell from '../layout/SectionShell.astro';
import SectionTitle from '../ui/SectionTitle.astro';
import Carousel from '../ui/Carousel.astro';
import Img from '../ui/Img.astro';
import Button from '../ui/Button.astro';
import ContactButton from '../ui/ContactButton.astro';
import type { ShowcasePop, ShowcaseSection } from '../../lib/types';
import { lowRes } from '../../lib/images';
import { popAlignment } from '../../lib/pop-alignment';
import type { LandingContext } from '../../lib/context';

interface Props {
  section: ShowcaseSection;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  text: Record<string, any>;
  ctx: LandingContext;
}
const { section, text, ctx } = Astro.props;
const { ui } = ctx;
const titleId = `${section.id}-title`;
const pops = section.slides.some((slide) => slide.pop);
const popInsets = await Promise.all(section.slides.map((slide) => slide.pop ? popAlignment(ctx.site, slide.pop.image) : undefined));
const largerPops = ['hora-loca', 'recibe'].includes(section.id);
const popSizes = largerPops ? '(min-width: 1401px) 81vw, 60vw' : '(max-width: 1400px) 60vw, 1100px';
const isLedRobot = (index: number) => section.id === 'hora-loca' && section.slides[index].id === 'robots-led';
const largePopScale = (index: number) => isLedRobot(index) ? 1.3225 : 1.35;
const desktopPopLift = 0.04;
// Referencia inicial del robot, antes de reducir su bottom negativo un 20 %.
const largePopPeek = (index: number) => isLedRobot(index) ? -0.06 : 0.08;
const robotBottomFactor = 0.8;
// Reservar solo el espacio que realmente sobresale, descontando los márgenes transparentes.
// El cálculo se resuelve al compilar y con CSS: no mide ni mueve el layout al hacer scroll.
const popRoom = (large = false) => {
  const linear = (height: number, fixed: number) => `calc(${height.toFixed(8)} * var(--pop-layout-height, var(--slide-h)) + ${fixed.toFixed(5)}px)`;
  const rooms = section.slides.flatMap((slide, index) => {
    const inset = popInsets[index];
    if (!slide.pop || !inset) return [];
    const scale = large ? largePopScale(index) : 1;
    const height = (slide.pop.width ?? 40) * 0.021594 / inset.ratio;
    const fixed = (section.popGrow ?? 0) / inset.ratio;
    if (large && isLedRobot(index)) {
      const remaining = (1 - robotBottomFactor) * scale * (1 - inset.top);
      const offset = 1 - robotBottomFactor * (1 + largePopPeek(index));
      return [linear(remaining * height - offset, remaining * fixed)];
    }
    const visible = scale * (1 - inset.top - inset.bottom);
    const fromPrior = -scale * inset.top;
    const priorRoom = linear(fromPrior * height - (slide.pop.top ?? -12) / 100 + (large ? desktopPopLift : 0), fromPrior * fixed);
    // Reservar el saliente visible de cada recorte, incluido su margen transparente.
    const raisedRoom = large ? `max(${priorRoom}, ${linear(largePopPeek(index), 0)})` : priorRoom;
    // El anclaje inferior conserva los personajes que ya bajaban más del borde.
    return [`min(${raisedRoom}, ${linear(visible * height - 1, visible * fixed)})`];
  });
  return rooms.length ? `max(0px, ${rooms.join(', ')})` : '0px';
};
const cutoutStyle = (index: number) => {
  const inset = popInsets[index];
  return inset ? `--mpop-edge:${inset.right}%;--mpop-head:${inset.top};--mpop-foot:${inset.bottom};--mpop-ratio:${inset.ratio}${largerPops ? `;--desktop-pop-scale:${largePopScale(index)};--desktop-pop-peek:${largePopPeek(index) * 100}cqh` : ''}` : undefined;
};
// Capas que acompañan al personaje: tinte de color y/o capa oscura sobre la foto, y un resplandor (luz) que puede
// pasar también sobre el degradado de la izquierda
const popBg = (pop: ShowcasePop) =>
  [
    pop.tint && `linear-gradient(90deg, ${pop.tint}, ${pop.tintRight ?? pop.tint})`,
    pop.shade && `linear-gradient(rgb(0 0 0 / ${pop.shade}), rgb(0 0 0 / ${pop.shade}))`,
  ]
    .filter(Boolean)
    .join(', ');
---

<SectionShell id={section.id} site={ctx.site} space={section.space} background={section.background} decor={section.decor} contained={false} labelledby={titleId} flushBottom anim={section.anim} count={section.slides.length}>
  <div class="container">
    <SectionTitle id={titleId} text={text.title} variant={section.titleStyle ?? 'pill'} size={section.titleSize} />
  </div>
  <div class="showcase__slides" style={[section.popGrow && `--pop-grow:${section.popGrow}px`, `--desktop-pop-room:${popRoom()}`, largerPops && `--desktop-pop-room-large:${popRoom(true)};--desktop-pop-lift:${desktopPopLift * 100}cqh;--robot-bottom-factor:${robotBottomFactor}`].filter(Boolean).join(';')}>
    <Carousel label={text.title} variant="showcase" dots="overlay" arrows={section.id === 'hora-loca' || section.id === 'recibe' ? 'edge-both' : 'edge'} ui={ui.carousel} loop={section.loop}>
      {
        section.slides.map((slide, i) => {
          const s = text.slides[slide.id];
          // Foto en la parte derecha de la diapositiva: 1564 × 777 px a 1920 de pantalla
          const inside = slide.inside && slide.pop;
          const small = !inside && !slide.bg && lowRes(ctx.site, slide.image, [1564, 777]);
          return (
            <article
              class:list={['slide', slide.glow && 'slide--glow', small && 'slide--lowres', inside && 'slide--inside', slide.bg && 'slide--bg', slide.imageBox && 'slide--box']}
              data-slide={slide.id}
              style={[slide.accent && `--accent:${slide.accent}`, slide.bg && `background:${slide.bg}`, slide.imagePos && `--img-pos:${slide.imagePos}`, slide.imagePosMobile && `--img-pos-m:${slide.imagePosMobile}`, slide.imageBox && `--img-max:${slide.imageBox.maxWidth}%`, slide.imageMaxWidth && `--img-maxw:${slide.imageMaxWidth}px`, slide.glow && `--glow:${slide.glow}`, slide.glowAt && `--glow-at:${slide.glowAt}`, small && `--fit-h:${small.height}px`, cutoutStyle(i)].filter(Boolean).join(';') || undefined}
            >
              {small && <Img site={ctx.site} src={slide.image} alt="" class="slide__backdrop" sizes="480px" maxWidth={480} />}
              <Img site={ctx.site} src={slide.image} alt={inside ? '' : s.alt ?? ''} class="slide__img" sizes="(max-width: 700px) 100vw, 82vw" />
              {inside && (
                <div class="slide__inside" style={`--pop-cx:${(slide.pop!.left ?? 50) + (slide.pop!.width ?? 40) / 2};--pop-width:${slide.pop!.width ?? 40};--pop-top:${slide.pop!.top ?? -12}`}>
                  <Img site={ctx.site} src={slide.pop!.image} alt={s.alt ?? ''} sizes={largerPops ? popSizes : '(max-width: 700px) 60vw, 520px'} maxWidth={largerPops ? 2160 : 1040} />
                </div>
              )}
              {slide.pop && popBg(slide.pop) && <div class="slide__popbg" aria-hidden="true" style={`--pop-bg:${popBg(slide.pop)}`} />}
              <div class="slide__shade" aria-hidden="true" />
              {slide.pop?.glow && (
                <div class="slide__popglow" aria-hidden="true" style={`--pop-glow:radial-gradient(ellipse ${slide.pop.glowSize ?? '40% 85%'} at ${slide.pop.glowAt ?? '80% 50%'}, ${slide.pop.glow}, transparent)`} />
              )}
              {
                /* Personaje en el móvil: dentro de la diapositiva, por detrás del título y el botón (en escritorio va en
                   la capa de encima, ver .showcase__pops) */
                slide.pop && (
                  <div class:list={['slide__mpop', slide.inside && 'slide__mpop--still']} aria-hidden="true" style={[slide.pop.mobileScale && `--mpop-k:${slide.pop.mobileScale}`, slide.pop.mobileRight && `--mpop-right:${slide.pop.mobileRight}`, slide.pop.mobileTop && `--mpop-top:${slide.pop.mobileTop}`].filter(Boolean).join(';') || undefined}>
                    <Img site={ctx.site} src={slide.pop.image} alt="" sizes="(max-width: 1400px) 60vw, 1100px" maxWidth={1600} optional />
                  </div>
                )
              }
              <div class="slide__content">
                {s.kicker && <p class="slide__kicker">{s.kicker}</p>}
                {slide.titleImage ? (
                  <h3 class="slide__title-img">
                    <Img site={ctx.site} src={slide.titleImage} alt={s.title} sizes="40vw" maxWidth={1440} />
                  </h3>
                ) : (
                  <h3 class="slide__title" style={slide.titleGrow ? `--title-grow:${slide.titleGrow}px` : undefined}>{s.title}</h3>
                )}
                {s.cta === ui.contact ? (
                  <ContactButton href={ctx.whatsappFor(s.title)} ctx={ctx} />
                ) : (
                  <Button href={ctx.whatsappFor(s.title)}>{s.cta ?? ui.want}</Button>
                )}
              </div>
            </article>
          );
        })
      }
    </Carousel>
    {
      /* Personajes recortados: van fuera de las diapositivas (que recortan lo que se sale) para poder asomar por arriba */
      pops && (
        <div class="showcase__pops" aria-hidden="true" data-pops>
          {/* Tira con un hueco por diapositiva: se desplaza a la vez que el carrusel, así cada personaje va con la suya */}
          <div class="showcase__strip" data-strip>
            {section.slides.map((slide, i) =>
              slide.pop ? (
                <div class:list={['showcase__pop', slide.inside && 'showcase__pop--still']} data-pop={slide.id} style={`left:${i * 100}%;--pop-cx:${(slide.pop.left ?? 50) + (slide.pop.width ?? 40) / 2};--pop-width:${slide.pop.width ?? 40};--pop-top:${slide.pop.top ?? -12};${cutoutStyle(i) ?? ''}`}>
                  <Img site={ctx.site} src={slide.pop.image} alt="" sizes={popSizes} maxWidth={largerPops ? 2160 : 1600} optional />
                </div>
              ) : (
                <span hidden />
              ),
            )}
          </div>
        </div>
      )
    }
  </div>
</SectionShell>

<script>
  // El personaje de la diapositiva que se ve entra desde la esquina de abajo a la derecha: en escritorio al pasar
  // el ratón por el carrusel; en pantallas táctiles, en cuanto el carrusel está a la vista. Si cambia la
  // diapositiva, el anterior se va con la suya y entra el nuevo; al salir (ratón o pantalla), se va por la esquina.
  const touch = !matchMedia('(hover: hover) and (pointer: fine)').matches;
  document.querySelectorAll<HTMLElement>('[data-pops]').forEach((layer) => {
    const zone = layer.parentElement!;
    const track = zone.querySelector<HTMLElement>('[data-track]');
    // Las secciones con animación de scroll mueven el carrusel por su cuenta: ahí no se usa
    if (!track || zone.closest('[data-anim]')) return;
    const strip = layer.querySelector<HTMLElement>('[data-strip]')!;
    const pops = Array.from(strip.children) as HTMLElement[];
    const slides = Array.from(track.children) as HTMLElement[];
    // En el móvil el personaje va dentro de la diapositiva; en el resto, en la capa de encima
    const mobile = matchMedia('(max-width: 700px)');
    const imgOf = (i: number) => (mobile.matches ? slides[i]?.querySelector<HTMLImageElement>('.slide__mpop img') : pops[i]?.querySelector<HTMLImageElement>('img')) ?? null;
    const pending = new WeakMap<HTMLImageElement, Promise<boolean>>();
    const decoded = new WeakMap<HTMLImageElement, string>();
    const retried = new WeakSet<HTMLImageElement>();
    // Fuerza la descarga aunque la imagen siga fuera de la vista. Un fallo transitorio tiene un solo reintento;
    // nunca se activa el desenfoque del fondo hasta que el personaje se pueda pintar.
    const prepare = (img: HTMLImageElement, priority: 'high' | 'low') => {
      img.fetchPriority = priority;
      const existing = pending.get(img);
      if (existing) return existing;
      if (img.complete && img.naturalWidth > 0 && decoded.get(img) === img.currentSrc) return Promise.resolve(true);
      const ready = new Promise<boolean>((resolve) => {
        let settled = false;
        const finish = (ok: boolean) => {
          if (settled) return;
          settled = true;
          img.removeEventListener('load', loaded);
          img.removeEventListener('error', failed);
          if (ok) decoded.set(img, img.currentSrc);
          resolve(ok);
        };
        const loaded = () => {
          // Safari puede rechazar decode() aun habiendo cargado la imagen; load + naturalWidth son el respaldo.
          img.decode().catch(() => {}).then(() => {
            if (img.complete && img.naturalWidth > 0) finish(true);
          });
        };
        const failed = () => {
          if (retried.has(img) || !navigator.onLine) return finish(false);
          retried.add(img);
          setTimeout(() => {
            if (settled) return;
            const retry = (src: string) => {
              const url = new URL(src, document.baseURI);
              url.searchParams.set('retry', '1');
              return url.href;
            };
            // Conserva las versiones responsive y evita reutilizar una respuesta fallida de la caché.
            if (img.srcset) img.srcset = img.srcset.split(',').map((candidate) => {
              const [src, ...size] = candidate.trim().split(/\s+/);
              return [retry(src), ...size].join(' ');
            }).join(', ');
            img.src = retry(img.src);
          }, 300);
        };
        img.addEventListener('load', loaded);
        img.addEventListener('error', failed);
        img.loading = 'eager';
        if (img.complete) {
          if (img.naturalWidth > 0) loaded();
          else failed();
        }
      });
      pending.set(img, ready);
      ready.then(() => pending.delete(img));
      return ready;
    };
    let shown = -1;
    let selected: HTMLImageElement | null = null;
    let over = false;
    let tok = 0;
    let slideWidth = Math.max(1, slides[0]?.offsetWidth ?? 1);
    const current = () => Math.max(0, Math.min(slides.length - 1, Math.round(track.scrollLeft / slideWidth)));
    // Personaje (en la capa de encima) y su fondo (dentro de la diapositiva) se encienden y apagan juntos
    const toggle = (i: number, on: boolean) => {
      pops[i]?.classList.toggle('is-on', on);
      slides[i]?.classList.toggle('is-pop', on);
    };
    const show = () => {
      const i = current();
      const next = over && pops[i]?.classList.contains('showcase__pop') ? i : -1;
      const img = next >= 0 ? imgOf(next) : null;
      if (next === shown && img === selected) return;
      const my = ++tok;
      toggle(shown, false);
      if (selected) selected.fetchPriority = 'low';
      shown = next;
      selected = img;
      if (next < 0 || !img) return;
      // Entra cuando su imagen ya está lista para pintarse: así también la primera vez se ve la animación entera
      prepare(img, 'high').then((ready) => {
        if (ready && my === tok && shown === next && img === imgOf(next)) toggle(next, true);
      });
    };
    let near = false;
    let warmed = -1;
    const warm = () => {
      if (!near && !over) return;
      const i = current();
      if (warmed === i) return;
      warmed = i;
      [i, (i + 1) % slides.length, (i - 1 + slides.length) % slides.length].forEach((n) => {
        const img = imgOf(n);
        if (img) prepare(img, n === i ? 'high' : 'low');
      });
    };
    // La tira de personajes sigue al carrusel (también mientras se desliza entre diapositivas)
    const follow = () => {
      strip.style.transform = `translate3d(${-track.scrollLeft}px, 0, 0)`;
      warm();
      show();
    };
    const refresh = () => {
      toggle(shown, false);
      shown = -1;
      selected = null;
      warmed = -1;
      follow();
    };
    // Al cambiar de tamaño puede tocar otra copia o versión responsive del personaje.
    mobile.addEventListener('change', refresh);
    addEventListener('online', refresh);
    zone.querySelectorAll<HTMLImageElement>('.showcase__pop img, .slide__mpop img').forEach((img) => {
      img.addEventListener('error', () => {
        if (img === selected) refresh();
      });
    });
    let frame = 0;
    track.addEventListener('scroll', () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(follow);
    }, { passive: true });
    new ResizeObserver(([entry]) => {
      // Reutilizar la observación de tamaño: el texto puede superar el alto previsto en ventanas bajas.
      slideWidth = Math.max(1, slides[0]?.offsetWidth ?? 1);
      warmed = -1;
      zone.style.setProperty('--pop-layout-height', `${entry.contentRect.height}px`);
      follow();
    }).observe(track);

    // Adelanta el personaje actual y sus vecinos, sin poner todos a competir por la conexión.
    const ahead = (margin: string) =>
      new IntersectionObserver((entries, io) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        near = true;
        warm();
      }, { rootMargin: margin }).observe(zone);
    ahead('100% 0px');

    if (touch) {
      // Táctil: el personaje entra cuando la mayor parte del carrusel está en pantalla y se va al salir
      new IntersectionObserver(([e]) => {
        over = e.intersectionRatio >= 0.6;
        follow();
      }, { threshold: [0, 0.6] }).observe(zone);
    } else {
      zone.addEventListener('pointerenter', () => { over = true; follow(); });
      zone.addEventListener('pointerleave', () => { over = false; show(); });
      // Si la página se mueve bajo el cursor quieto (rueda), se comprueba que siga encima
      addEventListener('scroll', () => {
        if (over && !zone.matches(':hover')) { over = false; show(); }
      }, { passive: true });
    }
  });
</script>

<style>
  /* El título de la sección queda por delante de los personajes que asoman por arriba */
  .container { position: relative; z-index: 2; }
  .showcase__slides {
    position: relative;
    margin-top: 1.5rem;
    padding-top: var(--pop-title-room);
    --pop-title-room: var(--desktop-pop-room, 0px);
    --carousel-gap: 0px;
    /* Margen del texto, el botón y los puntos: 228 px de 1920 en el diseño (la diapositiva va a sangre, así que
       se mide sobre el ancho de la pantalla, no sobre el lienzo escalado) */
    --carousel-dots-left: max(2rem, calc(11.9 * var(--vw) + max(0px, (100vw - 1920px) / 2)));
    /* Alto de la diapositiva: proporción del diseño (1842 × 853), sin pasar del 72 % del alto de la pantalla */
    --slide-h: clamp(34rem, min(44.4 * var(--vw), 72svh), 85.3rem);
  }
  /* Hueco al final del tamaño de la franja de la derecha: así la última diapositiva también queda alineada
     a la izquierda (si no, se corre a la derecha y asoma la anterior por el borde izquierdo) */
  .showcase__slides :global(.carousel__track) { display: flex; }
  .showcase__slides :global(.carousel__track > *) { flex: 0 0 95.94%; }
  .showcase__slides :global(.carousel__track)::after { content: ''; flex: 0 0 4.06%; }
  .showcase__slides :global(.carousel__dots--overlay) { bottom: clamp(3rem, calc(3.3 * var(--u)), 6.3rem); gap: clamp(1.4rem, calc(1.35 * var(--u)), 2.6rem); }
  .showcase__slides :global(.carousel__dots) { --dot: calc(clamp(1.2rem, calc(0.94 * var(--u)), 1.8rem) - 0.4rem); }
  .showcase__slides :global(.carousel__dots--overlay) { right: var(--carousel-dots-left); flex-wrap: wrap; }
  /* Franja derecha: la diapositiva siguiente asoma desenfocada, como en el diseño */
  @media (min-width: 701px) {
    :global(section:not([data-anim])) .showcase__slides :global(.carousel__viewport)::after {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      left: 95.94%;
      right: 0;
      z-index: 1;
      pointer-events: none;
      -webkit-backdrop-filter: blur(14px) brightness(0.85);
      backdrop-filter: blur(14px) brightness(0.85);
    }
  }
  @media (max-width: 700px) {
    .showcase__slides :global(.carousel__dots--overlay) { gap: 1rem; bottom: 2.4rem; }
    .showcase__slides :global(.carousel__dots) { --dot: 0.6rem; }
  }
  @media (max-width: 700px) {
    .showcase__slides :global(.carousel__track > *) { flex-basis: 100%; }
    .showcase__slides :global(.carousel__track)::after { display: none; }
  }

  /* Capa de los personajes: cubre la diapositiva visible (sin la franja desenfocada de la derecha).
     Cada personaje se coloca con su posición y ancho del diseño: sobresale por arriba y lo que pasa del borde
     de abajo (o del derecho) se recorta. */
  .showcase__pops {
    position: absolute;
    top: var(--pop-title-room);
    bottom: 0;
    left: 0;
    width: 95.94%;
    z-index: 1;
    pointer-events: none;
    clip-path: inset(calc(-1 * var(--pop-title-room)) 0 0 0);
  }
  .showcase__strip { position: absolute; inset: 0; will-change: transform; }
  /* Entra desde la esquina de abajo a la derecha (asoma por el borde, que lo recorta) con un leve giro, y frena
     suave al llegar; al irse vuelve hacia la esquina, más rápido */
  .showcase__pop {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 100%;
    container-type: size;
    opacity: 0;
    transform: translate(26%, 20%) rotate(5deg);
    transform-origin: 100% 100%;
    transition: transform 0.6s cubic-bezier(0.5, 0, 0.75, 0.3), opacity 0.5s ease 0.1s;
    will-change: transform, opacity;
  }
  .showcase__pop.is-on {
    opacity: 1;
    transform: none;
    transition: transform 1.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.6s ease;
  }
  .showcase__pop :global(img) {
    position: absolute;
    /* Medidas del diseño (diapositiva de 1842 × 853): el tamaño va con el ALTO de la diapositiva (así no se
       agranda en pantallas panorámicas) y el centro, con su ANCHO (como la foto de fondo) */
    left: calc(var(--pop-cx) * 1%);
    width: calc((var(--pop-width) * 2.1594cqh + var(--pop-grow, 0px)) * var(--pop-scale, 1));
    translate: -50% 0;
    max-width: none;
    height: auto;
  }
  /* Móvil: la diapositiva ocupa todo el ancho y el texto va abajo a la izquierda. El personaje va dentro de la
     diapositiva, por detrás del texto, apoyado abajo a la derecha y un poco más alto que ella: asoma por arriba
     (la diapositiva se recorta solo por los lados y por abajo, y el carrusel deja sitio encima) */
  .slide__mpop { display: none; }
  @media (max-width: 700px) {
    .showcase__pops { display: none; }
    .showcase__slides { --pop-room: calc(var(--slide-h) * 0.14); --pop-title-room: var(--pop-room); }
    /* overflow-y: hidden: el carrusel solo se desliza en horizontal (el personaje fuera de su sitio no lo hace desplazable en vertical) */
    .showcase__slides :global(.carousel__track) { padding-top: var(--pop-room); margin-top: calc(-1 * var(--pop-room)); overflow-y: hidden; }
    .showcase__slides :global(.carousel__viewport) { display: flow-root; } /* que ese margen no arrastre el slider hacia arriba */
    .showcase__slides .slide { overflow: visible; clip-path: inset(calc(-1 * var(--pop-room)) 0 0 0); }
    /* Lo demás no se sale por arriba: fotos (y su desenfoque) recortadas a su caja */
    .slide :global(.slide__img) { clip-path: inset(0); }
    .slide:global(.is-pop) :global(.slide__img) { scale: none; }
    .slide :global(.slide__backdrop) { clip-path: inset(6.6%); }
    .slide__content { text-shadow: 0 0.2rem 1.2rem rgb(0 0 0 / 0.45); }
    .slide__mpop {
      display: block;
      position: absolute;
      inset: 0;
      z-index: -1;
      container-type: size;
      --mpop-prior-top: var(--mpop-top, calc(100cqh - 112cqh * var(--mpop-k, 1)));
      pointer-events: none;
      opacity: 0;
      transform: translate(26%, 20%) rotate(5deg);
