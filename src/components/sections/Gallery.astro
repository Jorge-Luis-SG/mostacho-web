---
import SectionShell from '../layout/SectionShell.astro';
import SectionTitle from '../ui/SectionTitle.astro';
import Carousel from '../ui/Carousel.astro';
import Img from '../ui/Img.astro';
import type { GallerySection } from '../../lib/types';
import { lowRes } from '../../lib/images';
import type { LandingContext } from '../../lib/context';

interface Props {
  section: GallerySection;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  text: Record<string, any>;
  ctx: LandingContext;
}
const { section, text, ctx } = Astro.props;
const titleId = `${section.id}-title`;
---

<SectionShell id={section.id} site={ctx.site} space={section.space} background={section.background} decor={section.decor} contained={false} labelledby={titleId} anim={section.anim} count={section.items.length}>
  <div class="container">
    <SectionTitle id={titleId} text={text.title} variant={section.titleStyle ?? 'pill'} size={section.titleSize} />
  </div>
  <div class="gallery">
    <Carousel label={text.title} variant="gallery" arrows="sides" ui={ctx.ui.carousel}>
      {
        section.items.map((item) => {
          // Foto de la galería a 1920 de pantalla: hasta 1376 × 699 px (la animación la muestra grande)
          const small = lowRes(ctx.site, item.image, [1376, 699]);
          return (
            <figure class:list={['gallery__item', small && 'gallery__item--lowres']}>
              {small && <Img site={ctx.site} src={item.image} alt="" class="gallery__backdrop" sizes="480px" maxWidth={480} />}
              <Img site={ctx.site} src={item.image} alt={text.items[item.id]?.alt ?? ''} sizes="(max-width: 700px) 88vw, 60vw" maxWidth={1920} />
            </figure>
          );
        })
      }
    </Carousel>
  </div>
</SectionShell>

<style>
  .gallery {
    position: relative;
    margin-top: clamp(2.4rem, calc(2.6 * var(--u)), 5rem);
    padding-left: calc(var(--edge) + clamp(1.6rem, calc(5.63 * var(--u)), 10.8rem));
    --carousel-gap: clamp(1.2rem, calc(2.34 * var(--u)), 4.5rem);
  }
  .gallery :global(.carousel__track) { grid-auto-columns: min(calc(59.7 * var(--u)), 114.6rem); }
  @media (max-width: 700px) {
    .gallery :global(.carousel__track) { grid-auto-columns: calc(86 * var(--u)); }
  }
  /* El diseño no muestra flechas: aparecen solo al pasar el ratón o con el teclado */
  .gallery :global(.carousel__arrow) { opacity: 0; transition: opacity 0.2s ease; }
  .gallery:hover :global(.carousel__arrow:not(:disabled)),
  .gallery:focus-within :global(.carousel__arrow:not(:disabled)) { opacity: 1; }
  .gallery :global(.carousel__arrow--prev) { left: 1.5rem; }
  .gallery :global(.carousel__arrow--next) { right: 1.5rem; }
  /* Foto vertical o pequeña: entera, sobre un fondo desenfocado de sí misma (sin ampliarla hasta pixelarla) */
  .gallery__item--lowres { position: relative; isolation: isolate; overflow: hidden; border-radius: var(--radius-lg); aspect-ratio: 1146 / 582; }
  .gallery__item--lowres :global(.gallery__backdrop) {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(24px) brightness(0.55) saturate(1.2);
    transform: scale(1.15);
    border-radius: 0;
  }
  .gallery__item--lowres :global(img:not(.gallery__backdrop)) { position: absolute; inset: 0; object-fit: contain; border-radius: 0; }
  .gallery__item :global(img), .gallery__item :global(.img-missing) {
    width: 100%;
    height: auto;
    aspect-ratio: 1146 / 582;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }
</style>
