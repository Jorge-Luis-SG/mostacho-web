---
import SectionShell from '../layout/SectionShell.astro';
import SectionTitle from '../ui/SectionTitle.astro';
import Carousel from '../ui/Carousel.astro';
import Img from '../ui/Img.astro';
import type { GallerySection } from '../../lib/types';
import type { LandingContext } from '../../lib/context';
import { resolveImage } from '../../lib/images';

interface Props {
  section: GallerySection;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  text: Record<string, any>;
  ctx: LandingContext;
}
const { section, text, ctx } = Astro.props;
const titleId = `${section.id}-title`;
---

<SectionShell id={section.id} site={ctx.site} space={section.space} background={section.background} decor={section.decor} contained={false} labelledby={titleId} anim={section.anim} count={section.items.length}>
  <div class="container">
    <SectionTitle id={titleId} text={text.title} variant={section.titleStyle ?? 'pill'} size={section.titleSize} />
  </div>
  <div class="gallery">
    <Carousel label={text.title} variant="gallery" arrows="sides" ui={ctx.ui.carousel} galleryRail={!section.anim}>
      {
        section.items.map((item) => {
          // La foto completa conserva a todos los personajes; una copia desenfocada rellena los laterales.
          const image = resolveImage(ctx.site, item.image);
          const ratio = image?.kind === 'raster' ? image.meta.width / image.meta.height : 1.5;
          // Con contain, una foto vertical ocupa menos ancho que la tarjeta: pide solo los píxeles que se ven.
          const sizes = `(max-width: 700px) ${(86 * Math.min(1, ratio / (4 / 3))).toFixed(2)}vw, ${(60 * Math.min(1, ratio / 1.5)).toFixed(2)}vw`;
          return (
            <figure class="gallery__item" style={item.pos ? `--pos:${item.pos}` : undefined}>
              <Img site={ctx.site} src={`blur/${item.image}`} alt="" class="gallery__backdrop" sizes="320px" maxWidth={320} optional />
              <Img site={ctx.site} src={item.image} alt={text.items[item.id]?.alt ?? ''} class="gallery__photo" sizes={sizes} maxWidth={1920} />
            </figure>
          );
        })
      }
    </Carousel>
  </div>
</SectionShell>

<script>
  // Recorrido original: arranque suave, todas las fotos seguidas, pausa y regreso más rápido.
  // El compositor mueve el carril; JavaScript solo prepara las fotos próximas y entrega el control al dedo.
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
  document.querySelectorAll<HTMLElement>('.gallery').forEach((gallery) => {
      const track = gallery.querySelector<HTMLElement>('[data-track]');
      const rail = gallery.querySelector<HTMLElement>('[data-gallery-rail]');
      if (!track || !rail || gallery.closest('[data-anim]')) return;
      const items = Array.from(rail.children) as HTMLElement[];
      let end = 0;
      let step = 1;
      let animation: Animation | null = null;
      let timer = 0;
      let generation = 0;
      let visible = false;
      let pointerHeld = false;
      let phase: 'idle' | 'loading' | 'out' | 'pause' | 'back' | 'done' | 'manual' = 'idle';
      let leg: { from: number; to: number; distance: number; direction: number; speed: number; ramp: number; total: number };
      let warmed = '';
      let warming: Promise<void> = Promise.resolve();
      const decoding = new WeakMap<HTMLImageElement, { src: string; ready: Promise<void> }>();
      const moving = () => phase === 'out' || phase === 'pause' || phase === 'back';
      const pause = () => {
        animation?.pause();
        clearInterval(timer);
        timer = 0;
      };
      const canPlay = () => visible && !document.hidden && !reduced.matches && !saveData && items.length > 1;
      const current = () => Math.max(0, Math.min(items.length - 1, Math.round(track.scrollLeft / step)));
      const prepare = (img: HTMLImageElement) => {
        if (img.loading !== 'eager') img.loading = 'eager';
        const src = img.currentSrc || img.src;
        const existing = decoding.get(img);
        if (existing?.src === src) return existing.ready;
        const entry = { src, ready: img.decode().catch(() => {}).then(() => { entry.src = img.currentSrc || img.src; }) };
        decoding.set(img, entry);
        return entry.ready;
      };
      const warm = (index: number) => {
        const back = phase === 'back';
        const key = `${index}:${back}`;
        if (warmed === key) return warming;
        warmed = key;
        const nearby = items.slice(Math.max(0, index - (back ? 3 : 1)), index + (back ? 2 : 4));
        warming = Promise.all(nearby.flatMap((item) => [...item.querySelectorAll<HTMLImageElement>('img')].map(prepare))).then(() => {});
        return warming;
      };
      const distanceAt = (t: number) => {
        const { ramp, total, speed, distance } = leg;
        return ramp === 0 ? distance : t < ramp ? 0.5 * speed * t * t / ramp : t > total - ramp ? distance - 0.5 * speed * (total - t) ** 2 / ramp : speed * (t - ramp / 2);
      };
      const visualLeft = () => animation && phase !== 'pause'
        ? leg.from + leg.direction * distanceAt(Math.min(leg.total, Number(animation.currentTime ?? 0) / 1000))
        : phase === 'pause' ? end : track.scrollLeft;
      const release = () => {
        const left = visualLeft();
        pause();
        animation?.cancel();
        animation = null;
        rail.style.willChange = '';
        // Una sola sincronización entrega al scroll nativo exactamente la posición que se estaba viendo.
        track.scrollLeft = left;
      };
      const begin = (to: number, speed: number, ramp = 1) => {
        const from = track.scrollLeft;
        const distance = Math.abs(to - from);
        const acceleration = Math.min(ramp, distance / speed);
        leg = { from, to, distance, direction: Math.sign(to - from), speed, ramp: acceleration, total: distance / speed + acceleration };
        phase = to === 0 ? 'back' : 'out';
        warmed = '';
        const base = track.scrollLeft;
        const frames: Keyframe[] = [];
        // Solo se muestrean las dos rampas; el tramo central mantiene su velocidad lineal original.
        const times = new Set([0, acceleration, leg.total - acceleration, leg.total]);
        for (let t = 0; t < acceleration; t += 1 / 60) { times.add(t); times.add(leg.total - t); }
        for (const t of [...times].sort((a, b) => a - b)) {
          frames.push({ offset: leg.total ? t / leg.total : 1, transform: `translate3d(${base - from - leg.direction * distanceAt(t)}px, 0, 0)` });
        }
        rail.style.willChange = 'transform';
        animation = rail.animate(frames, { duration: Math.max(1, leg.total * 1000), fill: 'forwards', easing: 'linear' });
        animation.pause();
        animation.onfinish = () => {
          if (phase === 'out') {
            release();
            phase = 'pause';
            animation = rail.animate([{ transform: 'none' }, { transform: 'none' }], { duration: 700 });
            animation.pause();
            animation.onfinish = () => { animation?.cancel(); animation = null; begin(0, 1600, 1.2); resume(); };
            resume();
          } else { release(); phase = 'done'; track.style.scrollSnapType = ''; }
        };
      };
      const resume = () => {
        if (!canPlay() || !moving() || !animation) return;
        animation.play();
        if (!timer) timer = window.setInterval(() => {
          void warm(Math.max(0, Math.min(items.length - 1, Math.floor(visualLeft() / step))));
        }, 120);
      };
      const play = async () => {
        if (phase !== 'idle' || !canPlay()) return;
        if (end < 10) { phase = 'done'; return; }
        phase = 'loading';
        const mine = ++generation;
        warmed = '';
        await warm(current());
        if (mine !== generation || phase !== 'loading') return;
        track.style.scrollSnapType = 'none';
        begin(end, 800);
        resume();
      };
      const measure = () => {
        const wasMoving = moving();
        if (animation) release();
        const first = items[0]?.offsetLeft ?? 0;
        const positions = items.map((item) => item.offsetLeft - first);
        step = Math.max(1, (positions[1] ?? track.clientWidth) - (positions[0] ?? 0));
        end = Math.max(0, Math.min(track.scrollWidth - track.clientWidth, positions.at(-1) ?? 0));
        warmed = '';
        if (wasMoving) begin(phase === 'back' ? 0 : end, phase === 'back' ? 1600 : 800);
        resume();
        void play();
      };
      const interrupt = () => {
        generation++;
        if (animation) release();
        else pause();
        phase = 'manual';
        void warm(current());
        // El gesto nativo continúa desde el punto exacto donde se detuvo la animación.
      };
      const restoreSnap = () => { if (phase === 'manual' && !pointerHeld) track.style.scrollSnapType = ''; };
      const pointer = 'PointerEvent' in window;
      gallery.addEventListener(pointer ? 'pointerdown' : 'touchstart', () => { pointerHeld = true; interrupt(); }, { passive: true });
      [pointer ? 'pointerup' : 'touchend', pointer ? 'pointercancel' : 'touchcancel'].forEach((event) => window.addEventListener(event, () => {
        if (!pointerHeld) return;
        pointerHeld = false;
        restoreSnap();
      }, { passive: true }));
      gallery.addEventListener('keydown', interrupt, { passive: true });
      gallery.addEventListener('keyup', restoreSnap, { passive: true });
      gallery.addEventListener('focusin', interrupt, { passive: true });
      gallery.addEventListener('click', (event) => {
        if (!(event.target as Element).closest('button')) return;
        interrupt();
        restoreSnap();
      }, { capture: true });
      let settled = 0;
      track.addEventListener('scroll', () => {
        if (moving()) return;
        clearTimeout(settled);
        settled = window.setTimeout(() => { restoreSnap(); if (visible) void warm(current()); }, 150);
      }, { passive: true });
      track.addEventListener('wheel', (e) => Math.abs(e.deltaX) > Math.abs(e.deltaY) && interrupt(), { passive: true });
      const refresh = () => { pause(); resume(); void play(); };
      document.addEventListener('visibilitychange', refresh);
      reduced.addEventListener('change', refresh);
      new ResizeObserver(measure).observe(track);
      measure();
      new IntersectionObserver((entries, observer) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        void warm(current());
        observer.disconnect();
      }, { rootMargin: '600px 0px' }).observe(gallery);
      new IntersectionObserver(
        ([e]) => {
          visible = e.intersectionRatio >= 0.55;
          if (e.intersectionRatio < 0.2) {
            generation++;
            if (animation) release();
            else pause();
            phase = 'idle';
            track.style.scrollSnapType = 'none';
            track.scrollLeft = 0;
            track.style.scrollSnapType = '';
          } else if (visible) { resume(); void play(); }
          else pause();
        },
        { threshold: [0, 0.2, 0.55] },
      ).observe(gallery);
    });
</script>

<style>
  .gallery {
    position: relative;
    margin-top: 1.5rem;
    /* Margen izquierdo del diseño, por dentro del carrusel: al desplazarse, las fotos salen hasta el borde de la
       pantalla en vez de cortarse a la altura del margen */
    --gallery-card: min(calc(59.7 * var(--u)), 114.6rem);
    --gallery-left: max(var(--layout-gutter), calc((100% - var(--gallery-card)) / 2));
    --carousel-gap: clamp(1.2rem, calc(2.34 * var(--u)), 4.5rem);
  }
  .gallery :global(.carousel__track) {
    grid-auto-columns: var(--gallery-card);
    padding-inline: var(--gallery-left);
    scroll-padding-left: var(--gallery-left);
  }
  .gallery :global(.carousel__track--rail) { display: block; }
  .gallery :global(.carousel__track > .carousel__rail) { scroll-snap-align: none; }
  .gallery :global(.carousel__rail) {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: var(--gallery-card);
    gap: var(--carousel-gap);
    width: max-content;
  }
  @media (max-width: 700px) {
    .gallery { --gallery-card: 86vw; }
  }
  /* El diseño no muestra flechas: aparecen solo al pasar el ratón o con el teclado */
  .gallery :global(.carousel__arrow) { opacity: 0; transition: opacity 0.2s ease; }
  .gallery:hover :global(.carousel__arrow:not(:disabled)),
  .gallery:focus-within :global(.carousel__arrow:not(:disabled)) { opacity: 1; }
  .gallery :global(.carousel__arrow--prev) { left: 1.5rem; }
  .gallery :global(.carousel__arrow--next) { right: 1.5rem; }
  .gallery__item {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    aspect-ratio: 3 / 2;
    border-radius: var(--radius-lg);
    background: var(--color-card);
    contain: layout paint;
  }
  .gallery__item :global(img), .gallery__item :global(.img-missing) {
    width: 100%;
    height: 100%;
  }
  .gallery__item :global(.gallery__backdrop) {
    position: absolute;
    inset: 0;
    z-index: -1;
    object-fit: cover;
    transform: scale(1.12);
  }
  .gallery__item :global(.gallery__photo) {
    object-fit: contain;
    object-position: center;
  }
  @media (max-width: 700px) {
    .gallery__item { aspect-ratio: 4 / 3; }
  }
</style>
