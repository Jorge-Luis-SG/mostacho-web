---
import SectionShell from '../layout/SectionShell.astro';
import SectionTitle from '../ui/SectionTitle.astro';
import Carousel from '../ui/Carousel.astro';
import Img from '../ui/Img.astro';
import type { GallerySection } from '../../lib/types';
import type { LandingContext } from '../../lib/context';
import { resolveImage } from '../../lib/images';

interface Props {
  section: GallerySection;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  text: Record<string, any>;
  ctx: LandingContext;
}
const { section, text, ctx } = Astro.props;
const titleId = `${section.id}-title`;
---

<SectionShell id={section.id} site={ctx.site} space={section.space} background={section.background} decor={section.decor} contained={false} labelledby={titleId} anim={section.anim} count={section.items.length}>
  <div class="container">
    <SectionTitle id={titleId} text={text.title} variant={section.titleStyle ?? 'pill'} size={section.titleSize} />
  </div>
  <div class="gallery">
    <Carousel label={text.title} variant="gallery" arrows="sides" ui={ctx.ui.carousel}>
      {
        section.items.map((item) => {
          // La foto completa conserva a todos los personajes; una copia desenfocada rellena los laterales.
          const image = resolveImage(ctx.site, item.image);
          const ratio = image?.kind === 'raster' ? image.meta.width / image.meta.height : 1.5;
          // Con contain, una foto vertical ocupa menos ancho que la tarjeta: pide solo los píxeles que se ven.
          const sizes = `(max-width: 700px) ${(86 * Math.min(1, ratio / (4 / 3))).toFixed(2)}vw, ${(60 * Math.min(1, ratio / 1.5)).toFixed(2)}vw`;
          return (
            <figure class="gallery__item" style={item.pos ? `--pos:${item.pos}` : undefined}>
              <Img site={ctx.site} src={`blur/${item.image}`} alt="" class="gallery__backdrop" sizes="320px" maxWidth={320} optional />
              <Img site={ctx.site} src={item.image} alt={text.items[item.id]?.alt ?? ''} class="gallery__photo" sizes={sizes} maxWidth={1920} />
            </figure>
          );
        })
      }
    </Carousel>
  </div>
</SectionShell>

<script>
  // El desplazamiento suave lo hace el navegador: no se escribe scrollLeft en cada fotograma.
  // Solo se preparan la foto actual y las próximas; cualquier interacción da el control al visitante.
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
  document.querySelectorAll<HTMLElement>('.gallery').forEach((gallery) => {
      const track = gallery.querySelector<HTMLElement>('[data-track]');
      if (!track || gallery.closest('[data-anim]')) return;
      const items = Array.from(track.children) as HTMLElement[];
      let positions: number[] = [];
      let timer = 0;
      let token = 0;
      let visible = false;
      let interrupted = false;
      let hovered = false;
      let direction = 1;
      const decoding = new WeakSet<HTMLImageElement>();
      const pause = () => {
        clearTimeout(timer);
        timer = 0;
        token++;
      };
      const canPlay = () => visible && !interrupted && !hovered && !document.hidden && !reduced.matches && !saveData && items.length > 1;
      const current = () => {
        const left = track.scrollLeft;
        return positions.reduce((best, pos, i) => Math.abs(pos - left) < Math.abs(positions[best] - left) ? i : best, 0);
      };
      const warm = (index: number) => {
        items.slice(Math.max(0, index - 1), index + 2).forEach((item) => {
          item.querySelectorAll<HTMLImageElement>('img').forEach((img) => {
            img.loading = 'eager';
            // Preparar los píxeles antes de la transición, también cuando se navega con el dedo.
            if (decoding.has(img)) return;
            decoding.add(img);
            img.decode().catch(() => {}).finally(() => decoding.delete(img));
          });
        });
      };
      const schedule = () => {
        if (!timer && canPlay()) timer = window.setTimeout(advance, 3500);
      };
      const advance = async () => {
        timer = 0;
        if (!canPlay()) return;
        const my = ++token;
        const i = current();
        if (i === items.length - 1) direction = -1;
        else if (i === 0) direction = 1;
        const next = i + direction;
        warm(next);
        const img = items[next].querySelector<HTMLImageElement>('.gallery__photo');
        await img?.decode().catch(() => {});
        if (my !== token || !canPlay()) return;
        if (!img || (img.complete && img.naturalWidth > 0)) track.scrollTo({ left: positions[next], behavior: 'smooth' });
        schedule();
      };
      const measure = () => {
        pause();
        const first = items[0]?.offsetLeft ?? 0;
        positions = items.map((item) => item.offsetLeft - first);
        schedule();
      };
      const interrupt = () => {
        interrupted = true;
        pause();
        // El gesto nativo interrumpe el avance. scrollTo aquí fuerza el ajuste a una foto y da un salto.
        warm(current());
      };
      ['PointerEvent' in window ? 'pointerdown' : 'touchstart', 'keydown', 'focusin'].forEach((ev) => gallery.addEventListener(ev, interrupt, { passive: true }));
      // Tras un deslizamiento se preparan los vecinos, sin medir ni decodificar en cada fotograma.
      let settled = 0;
      track.addEventListener('scroll', () => {
        clearTimeout(settled);
        settled = window.setTimeout(() => { if (visible) warm(current()); }, 150);
      }, { passive: true });
      track.addEventListener('wheel', (e) => Math.abs(e.deltaX) > Math.abs(e.deltaY) && interrupt(), { passive: true });
      gallery.addEventListener('pointerenter', (e) => {
        if (e.pointerType !== 'mouse') return;
        hovered = true;
        pause();
      });
      gallery.addEventListener('pointerleave', () => { hovered = false; schedule(); });
      document.addEventListener('visibilitychange', () => { pause(); schedule(); });
      reduced.addEventListener('change', () => { pause(); schedule(); });
      new ResizeObserver(measure).observe(track);
      measure();
      new IntersectionObserver((entries, observer) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        warm(current());
        observer.disconnect();
      }, { rootMargin: '600px 0px' }).observe(gallery);
      new IntersectionObserver(
        ([e]) => {
          visible = e.intersectionRatio >= 0.55;
          if (e.intersectionRatio < 0.2) interrupted = false;
          if (visible) { warm(current()); schedule(); }
          else pause();
        },
        { threshold: [0, 0.2, 0.55] },
      ).observe(gallery);
    });
</script>

<style>
  .gallery {
    position: relative;
    margin-top: 1.5rem;
    /* Margen izquierdo del diseño, por dentro del carrusel: al desplazarse, las fotos salen hasta el borde de la
       pantalla en vez de cortarse a la altura del margen */
    --gallery-card: min(calc(59.7 * var(--u)), 114.6rem);
    --gallery-left: max(var(--layout-gutter), calc((100% - var(--gallery-card)) / 2));
    --carousel-gap: clamp(1.2rem, calc(2.34 * var(--u)), 4.5rem);
  }
  .gallery :global(.carousel__track) {
    grid-auto-columns: var(--gallery-card);
    padding-inline: var(--gallery-left);
    scroll-padding-left: var(--gallery-left);
  }
  @media (max-width: 700px) {
    .gallery { --gallery-card: 86vw; }
  }
  /* El diseño no muestra flechas: aparecen solo al pasar el ratón o con el teclado */
  .gallery :global(.carousel__arrow) { opacity: 0; transition: opacity 0.2s ease; }
  .gallery:hover :global(.carousel__arrow:not(:disabled)),
  .gallery:focus-within :global(.carousel__arrow:not(:disabled)) { opacity: 1; }
  .gallery :global(.carousel__arrow--prev) { left: 1.5rem; }
  .gallery :global(.carousel__arrow--next) { right: 1.5rem; }
  .gallery__item {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    aspect-ratio: 3 / 2;
    border-radius: var(--radius-lg);
    background: var(--color-card);
    contain: layout paint;
  }
  .gallery__item :global(img), .gallery__item :global(.img-missing) {
    width: 100%;
    height: 100%;
  }
  .gallery__item :global(.gallery__backdrop) {
    position: absolute;
    inset: 0;
    z-index: -1;
    object-fit: cover;
    transform: scale(1.12);
  }
  .gallery__item :global(.gallery__photo) {
    object-fit: contain;
    object-position: center;
  }
  @media (max-width: 700px) {
    .gallery__item { aspect-ratio: 4 / 3; }
  }
</style>
