---
/** Título + carrusel de tarjetas (Servicios, Efectos especiales, Servicios adicionales…). */
import SectionShell from '../layout/SectionShell.astro';
import SectionTitle from '../ui/SectionTitle.astro';
import Carousel from '../ui/Carousel.astro';
import Img from '../ui/Img.astro';
import BgVideo from '../ui/BgVideo.astro';
import Button from '../ui/Button.astro';
import ContactButton from '../ui/ContactButton.astro';
import type { CardsSection } from '../../lib/types';
import { fluid } from '../../lib/scale';
import type { LandingContext } from '../../lib/context';

interface Props {
  section: CardsSection;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  text: Record<string, any>;
  ctx: LandingContext;
}
const { section, text, ctx } = Astro.props;
const { ui } = ctx;
const titleId = `${section.id}-title`;
const uniformTitleSize = section.id === 'adicionales'
  ? fluid(Math.max(...section.items.map((item) => item.titleSize ?? 52)), 0.55)
  : undefined;
---

<SectionShell id={section.id} site={ctx.site} space={section.space} background={section.background} decor={section.decor} labelledby={titleId} anim={section.anim} count={section.items.length}>
  <SectionTitle id={titleId} text={text.title} variant={section.titleStyle ?? 'pill'} size={section.titleSize} />
  <div class:list={['cards', uniformTitleSize && 'cards--uniform']} style={uniformTitleSize ? `--uniform-title-size:${uniformTitleSize}` : undefined}>
    <Carousel label={text.title} variant="cards" dots="top" ui={ui.carousel} loop={section.loop}>
      {
        section.items.map((item) => {
          const card = text.items[item.id];
          return (
            <article class:list={['card', section.showText && 'card--text']} data-fx={item.fx} style={item.imagePos ? `--img-pos:${item.imagePos}` : undefined}>
              <Img site={ctx.site} src={item.image} alt={card.alt ?? ''} class="card__img" sizes="(max-width: 700px) 85vw, 420px" maxWidth={960} />
              <BgVideo site={ctx.site} src={item.video} class="card__img" hover />
              <div class="card__spacer" />
              <div class="card__body">
                {/* Copia desenfocada (pregenerada por npm run assets): mismo efecto que backdrop-filter, sin coste al hacer scroll */}
                <Img site={ctx.site} src={`blur/${item.image}`} alt="" class="card__blur" sizes="160px" maxWidth={160} optional />
                <h3 style={item.titleSize ? `font-size: calc(${fluid(item.titleSize, 0.55)} - 0.5rem - var(--title-shrink, 0px))` : undefined}>{card.title}</h3>
                {section.showText && card.text && <p>{card.text}</p>}
                {(card.cta ?? ui.contact) === ui.contact ? (
                  <ContactButton href={item.href ?? ctx.whatsappFor(card.title)} ctx={ctx} />
                ) : (
                  <Button href={item.href ?? ctx.whatsappFor(card.title)}>{card.cta}</Button>
                )}
              </div>
            </article>
          );
        })
      }
    </Carousel>
  </div>
</SectionShell>

<style>
  .cards {
    margin-top: clamp(1.6rem, calc(1.8 * var(--u)), 3.4rem);
    width: min(100%, var(--layout-cards));
    margin-inline: auto;
    --carousel-gap: clamp(1.2rem, calc(2.82 * var(--u)), 5.4rem);
    --carousel-arrow-offset: clamp(6rem, calc(5.83 * var(--u)), 11.2rem);
  }
  .cards :global(.carousel__dots--top) { margin-bottom: clamp(2rem, calc(2.4 * var(--u)), 4.6rem); }
  .cards :global(.carousel__track) {
    grid-auto-columns: calc((100% - 2 * var(--carousel-gap)) / 3);
  }
  @media (max-width: 1000px) {
    .cards :global(.carousel__track) { grid-auto-columns: calc((100% - var(--carousel-gap)) / 2); }
    /* Tablets: el carrusel no ocupa toda la pantalla; dos tarjetas de tamaño normal, centradas */
    .cards { width: min(100%, 680px); }
  }
  @media (max-width: 640px) {
    .cards :global(.carousel__track) { grid-auto-columns: min(85%, 320px); }
  }
  /* Adicionales en móvil: reservar el mismo espacio para los títulos de hasta tres líneas. */
  @media (max-width: 700px) {
    .cards--uniform .card { min-width: 0; }
    .cards--uniform h3 { min-height: calc(3 * 0.94 * (var(--uniform-title-size) - 0.5rem)); }
  }

  /* Tarjeta de alto fijo (419×679 en el diseño): la foto ocupa todo el fondo
     y la parte del texto la muestra desenfocada. */
  .card {
    --body: 0.442; /* fracción del alto de la tarjeta que ocupa el bloque de texto */
    --h: 679; /* alto de la tarjeta en el diseño (ancho 419) */
    container-type: inline-size;
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    aspect-ratio: 419 / var(--h);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-card);
  }
  .card :global(.card__img) {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }
  /* La foto llena solo la parte que se ve, por encima del bloque de texto (y un poco por debajo, que queda tras el
     desenfoque): así no se tapan las caras. Cada tarjeta puede ajustar su encuadre (site.json → imagePos).
     El video hace lo mismo, para que se vea entero lo importante. */
  .card :global(:is(img, video).card__img) {
    bottom: auto;
    height: calc(100cqw * var(--h) / 419 * (1 - var(--body)) + 3rem);
    object-position: var(--img-pos, 50% 30%);
  }
  .card__spacer { flex: 1 1 0; }
  /* Alto fijo del bloque de texto (diseño: 300 px sin descripción, 365 px con descripción) */
  /* La foto desenfocada ocupa el alto de toda la tarjeta y se alinea abajo con ella,
     así coincide con la foto nítida aunque el bloque de texto crezca. */
  .card :global(.card__blur) {
    position: absolute;
    left: 0;
    bottom: 0;
    z-index: -2;
    width: 100cqw;
    height: calc(100cqw * var(--h) / 419);
    max-width: none;
    object-fit: cover;
    object-position: center top;
  }
  .card__body {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    /* alto mínimo según el diseño (300 / 365 px de 679); crece si el texto es más largo */
    flex: 0 0 auto;
    min-height: calc(100cqw * var(--h) / 419 * var(--body));
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(1.6rem, calc(1.7 * var(--u)), 3.2rem) clamp(1.6rem, calc(1.8 * var(--u)), 3.4rem);
  }
  .card__body::before { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--gradient-card); }
  /* Títulos de las tarjetas: 5 px por debajo del tamaño del diseño */
  h3 { font-size: calc(var(--size-card-title) - 0.5rem - var(--title-shrink, 0px)); line-height: 0.94; }
  p { margin-top: clamp(1rem, calc(1.1 * var(--u)), 2.2rem); font-size: var(--size-card-text); line-height: 1.3; text-wrap: pretty; }
  /* Servicios: el texto compacto deja más espacio a la foto y al video. */
  .card--text { --h: 740; --body: 0.4; --title-shrink: 2px; }
  .card--text p { font-size: calc(var(--size-card-text) - 2px); }
  /* 1400 px o menos: textos y botón 2 px más pequeños, bloque oscuro más bajo (menos relleno) y la foto gana
     unos 20 px de alto */
  @media (max-width: 1400px) {
    .card--text { --body: 0.38; --title-shrink: 4px; }
    .card--text p { font-size: calc(var(--size-card-text) - 4px); margin-top: 0.8rem; }
    .card--text .card__body { padding-top: 1.4rem; padding-bottom: 1.4rem; }
    .card--text .card__body > :nth-last-child(2) { margin-bottom: 1.2rem; }
    .card--text .card__body :global(.btn) { font-size: calc(var(--size-button) - 2px); min-height: 0; padding-block: 0.9em; }
  }
  /* Tablets (2 tarjetas): el bloque de texto ocupa solo lo que necesita */
  @media (max-width: 1000px) {
    .card--text { --body: 0.33; }
    .card:not(.card--text) { --body: 0.26; }
  }
  /* Flechas para cambiar de tarjetas en todas las pantallas (por debajo de 1100 px el carrusel genérico las
     oculta): van a los lados, pegadas al carrusel */
  @media (max-width: 1100px) {
    .cards { --carousel-arrow-offset: clamp(-1.2rem, calc(-4vw + 2rem), 4.4rem); }
    .cards :global(.carousel.carousel--arrows-sides .carousel__arrow) { display: grid; z-index: 5; }
  }
  .card__body :global(.btn) { margin-top: auto; align-self: center; max-width: 100%; }
  .card__body > :nth-last-child(2) { margin-bottom: clamp(1.6rem, calc(2 * var(--u)), 3.8rem); }
</style>
