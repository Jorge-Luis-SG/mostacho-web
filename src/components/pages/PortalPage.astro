---
/** Página 1: portada para elegir el país (cada bandera lleva a su landing). */
import Img from '../ui/Img.astro';
import BgVideo from '../ui/BgVideo.astro';
import LangSwitch from '../ui/LangSwitch.astro';
import Icon from '../ui/Icon.astro';
import SocialLinks from '../ui/SocialLinks.astro';
import { langLinks, pathFor } from '../../lib/i18n';
import { routeOf } from '../../lib/sites';
import type { PortalConfig, Texts } from '../../lib/types';

interface Props {
  site: string;
  lang: string;
  config: PortalConfig;
  t: Texts;
}
const { site, lang, config, t } = Astro.props;
const { ui } = t;
---

<main class="portal">
  <Img site={site} src={config.background} alt="" class="portal__bg" priority optional />
  <BgVideo site={site} src={config.video} srcSmall={config.videoMobile} class="portal__bg" />
  <div class="portal__overlay" aria-hidden="true"></div>

  <LangSwitch links={langLinks(lang, routeOf(site))} label={ui.language} class="portal__lang" />

  {/* Música de la portada: suena en bucle (el navegador la deja empezar al primer toque o tecla) y se silencia aquí */}
  <audio src={`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}audio/portada.mp3`} loop preload="none" data-music></audio>
  <button type="button" class="portal__sound" data-sound-toggle aria-pressed="false" aria-label={ui.soundOff} data-label-on={ui.soundOn} data-label-off={ui.soundOff}>
    <Icon name="sound-on" size={26} class="portal__sound-on" />
    <Icon name="sound-off" size={26} class="portal__sound-off" />
  </button>

  <div class="portal__content">
    <div class="portal__logo">
      <Img site={site} src={config.logo} alt={ui.logoAlt} sizes="220px" priority />
    </div>

    <h1>{t.title}</h1>
    <p class="portal__subtitle" id="portal-question">{t.subtitle}</p>

    <ul role="list" class="portal__countries" aria-labelledby="portal-question">
      {
        config.countries.map((c) => (
          <li>
            <a href={pathFor(lang, routeOf(c.site))} class="portal__country">
              <span class="portal__flag">
                <Img site={site} src={c.flag} alt="" sizes="160px" />
              </span>
              {/* Nombre del país: aparece al pasar el ratón (la píldora se alarga hacia la derecha) */}
              <span class="portal__name">{t.countries[c.site]}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <SocialLinks networks={config.socialOrder} urls={config.social} labels={ui.social} class="portal__social" />
  </div>
</main>

<script>
  // Música de la portada. Suena en bucle salvo que el visitante la haya silenciado (se recuerda). Los navegadores
  // no dejan sonar nada hasta que el visitante toca la página: si no puede empezar sola, empieza al primer toque,
  // clic o tecla (el de la corneta solo la silencia). El volumen entra poco a poco.
  const audio = document.querySelector<HTMLAudioElement>('[data-music]');
  const btn = document.querySelector<HTMLButtonElement>('[data-sound-toggle]');
  if (audio && btn) {
    // Por defecto suena siempre (no se recuerda el silencio entre visitas)
    let muted = false;
    let fade = 0;
    const ramp = (to: number, ms: number, done?: () => void) => {
      cancelAnimationFrame(fade);
      const from = audio.volume;
      const t0 = performance.now();
      const tick = (now: number) => {
        const k = Math.min(1, (now - t0) / ms);
        audio.volume = Math.min(1, Math.max(0, from + (to - from) * k));
        if (k < 1) fade = requestAnimationFrame(tick);
        else done?.();
      };
      fade = requestAnimationFrame(tick);
    };
    const play = () => {
      if (muted || !audio.paused) return;
      audio.volume = 0;
      audio.play().then(
        () => {
          btn.classList.remove('is-waiting');
          ramp(0.7, 1500);
        },
        // Bloqueada por el navegador hasta el primer toque: la corneta late para invitar a tocarla
        () => btn.classList.add('is-waiting'),
      );
    };
    const show = () => {
      btn.setAttribute('aria-pressed', String(muted));
      btn.setAttribute('aria-label', (muted ? btn.dataset.labelOn : btn.dataset.labelOff) ?? '');
    };
    // La corneta: si la música suena, la silencia; si no suena (silenciada o aún bloqueada por el navegador), la activa
    btn.addEventListener('click', () => {
      muted = !audio.paused;
      show();
      if (muted) ramp(0, 400, () => audio.pause());
      else play();
    });
    const first = (e: Event) => {
      if ((e.target as Element | null)?.closest?.('[data-sound-toggle]')) return;
      ['pointerdown', 'touchend', 'keydown'].forEach((ev) => removeEventListener(ev, first, true));
      play();
    };
    ['pointerdown', 'touchend', 'keydown'].forEach((ev) => addEventListener(ev, first, true));
    show();
    play();
  }
</script>

<style>
  .portal {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    display: grid;
    align-items: start;
    justify-items: center;
    padding: clamp(6rem, calc(5.4 * var(--u)), 10.4rem) var(--layout-gutter) 6rem;
    overflow: hidden;
    background: var(--gradient-portal);
  }
  .portal :global(.portal__bg) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .portal__overlay { position: absolute; inset: 0; z-index: -1; background: var(--gradient-portal-overlay); }
  .portal__sound {
    position: absolute;
    top: clamp(2.4rem, calc(5.3 * var(--u)), 10.2rem);
    left: clamp(1.6rem, calc(5.94 * var(--u)), 11.4rem);
    display: grid;
    place-items: center;
    width: clamp(4.4rem, calc(3 * var(--u)), 5.6rem);
    aspect-ratio: 1;
    border-radius: 50%;
    color: var(--color-text);
    background: rgb(0 0 0 / 0.3);
    border: 1px solid var(--color-pill-border);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .portal__sound:global(.is-waiting) { animation: portal-sound-pulse 1.6s ease-in-out infinite; }
  @keyframes portal-sound-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgb(255 255 255 / 0.55); }
    50% { box-shadow: 0 0 0 1.2rem rgb(255 255 255 / 0); }
  }
  .portal__sound:hover { background: rgb(0 0 0 / 0.5); transform: scale(1.06); }
  .portal__sound :global(.portal__sound-off), .portal__sound[aria-pressed='true'] :global(.portal__sound-on) { display: none; }
  .portal__sound[aria-pressed='true'] :global(.portal__sound-off) { display: block; }
  .portal :global(.portal__lang) { position: absolute; top: clamp(2.4rem, calc(5.3 * var(--u)), 10.2rem); right: clamp(1.6rem, calc(5.94 * var(--u)), 11.4rem); }

  .portal__content { display: grid; justify-items: center; text-align: center; }
  .portal__logo { width: clamp(13rem, calc(10.4 * var(--u)), 20rem); }
  .portal__logo :global(img), .portal__logo :global(.img-missing) { width: 100%; height: auto; aspect-ratio: 200 / 210; object-fit: contain; }

  h1 { margin-top: clamp(4rem, calc(4.04 * var(--u)), 7.76rem); font-size: var(--size-portal-title); line-height: 0.928; }
  .portal__subtitle {
    margin-top: clamp(1.6rem, calc(1.63 * var(--u)), 3.13rem);
    font-family: var(--font-heading);
    font-weight: var(--heading-weight);
    text-transform: var(--heading-transform);
    font-size: var(--size-portal-subtitle);
    line-height: 1;
  }

  .portal__countries {
    --flag: clamp(10rem, calc(7.8 * var(--u)), 15rem);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(2.4rem, calc(2.6 * var(--u)), 5rem);
    margin-top: clamp(3rem, calc(3.77 * var(--u)), 7.24rem);
  }
  /* Cada país ocupa solo su círculo: al alargarse, la píldora no empuja a la otra bandera */
  .portal__countries li { position: relative; width: var(--flag); height: var(--flag); }
  /* Píldora de cristal: en reposo es solo el círculo de la bandera; al pasar el ratón se alarga y muestra el país.
     La de la izquierda (Ecuador) se abre hacia la izquierda, con el nombre delante de la bandera; la otra, hacia la derecha. */
  .portal__country {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    align-items: center;
    padding: clamp(0.8rem, calc(0.62 * var(--u)), 1.2rem);
    border-radius: 999px;
    background: var(--color-flag-ring);
    border: 2px solid var(--color-pill-border);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    transition: background 0.3s ease, box-shadow 0.3s ease;
  }
  .portal__flag {
    display: grid;
    place-items: center;
    flex: none;
    overflow: hidden;
    width: calc(var(--flag) - 2 * clamp(0.8rem, calc(0.62 * var(--u)), 1.2rem) - 4px);
    aspect-ratio: 1;
    border-radius: 50%;
  }
  .portal__name {
    max-width: 0;
    overflow: hidden;
    white-space: nowrap;
    opacity: 0;
    padding-inline: 0;
    font-family: var(--font-heading);
    font-weight: var(--heading-weight);
    text-transform: var(--heading-transform);
    letter-spacing: var(--heading-letter-spacing);
    font-size: calc(var(--flag) * 0.3);
    line-height: 1;
    color: var(--color-text);
    transition: max-width 0.4s cubic-bezier(0.2, 0.8, 0.25, 1), padding 0.4s cubic-bezier(0.2, 0.8, 0.25, 1), opacity 0.25s ease;
  }
  .portal__country:hover, .portal__country:focus-visible { background: rgb(255 255 255 / 0.2); box-shadow: 0 10px 30px -12px rgb(0 0 0 / 0.6); }
  .portal__country:hover .portal__name, .portal__country:focus-visible .portal__name {
    max-width: 12em;
    padding-inline: 0.55em 0.75em;
    opacity: 1;
    transition-delay: 0s, 0s, 0.1s;
  }
  .portal__countries li:first-child .portal__country { left: auto; right: 0; flex-direction: row-reverse; }
  .portal__countries li:first-child .portal__country:is(:hover, :focus-visible) .portal__name { padding-inline: 0.75em 0.55em; }
  .portal__flag :global(img), .portal__flag :global(.img-missing) {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }
  /* Las imágenes de las banderas traen un aro blanco: se amplían para que quede fuera del círculo */
  .portal__flag :global(img) { transform: scale(1.3); }
  .portal__flag :global(.img-missing) { font-size: 0.9rem; padding: 0.4rem; }

  /* Hasta 1550 px: contenido centrado en vertical y con más aire entre bloques */
  @media (max-width: 1550px) {
    .portal { align-items: center; padding-block: 6rem; }
    h1 { margin-top: clamp(4rem, 5vh, 6rem); }
    .portal__subtitle { margin-top: clamp(2rem, 2.6vh, 3.2rem); }
    .portal__countries { margin-top: clamp(4rem, 5.5vh, 6.4rem); }
    /* Móviles (540 px o menos): banderas 15 px más pequeñas, nombre del país a 2,2rem e iconos de redes más grandes */
  @media (max-width: 540px) {
    .portal__countries { --flag: calc(clamp(10rem, calc(7.8 * var(--u)), 15rem) - 15px); }
    .portal__name { font-size: 2.2rem; }
    /* Las píldoras van en la fila (no superpuestas): al abrirse una, la otra se aparta y la fila se recentra,
       así las dos caben siempre en la pantalla */
    .portal__countries li { width: auto; height: auto; }
    .portal__country, .portal__countries li:first-child .portal__country { position: relative; left: auto; right: auto; }
    /* Iconos de redes 4 px más grandes */
    .portal :global(.portal__social svg) { width: calc(clamp(2rem, calc(1.61 * var(--u)), 3.1rem) + 4px); height: auto; }
  }
  .portal :global(.portal__social) { margin-top: clamp(4.4rem, 6vh, 7rem); }
  }
  .portal :global(.portal__social) { margin-top: clamp(4rem, calc(3.25 * var(--u)), 6.25rem); gap: 2.4rem; }
</style>
