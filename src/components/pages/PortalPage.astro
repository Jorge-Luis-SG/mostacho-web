---
/** Página 1: portada para elegir el país (cada bandera lleva a su landing). */
import Img from '../ui/Img.astro';
import LangSwitch from '../ui/LangSwitch.astro';
import SocialLinks from '../ui/SocialLinks.astro';
import { langLinks, pathFor } from '../../lib/i18n';
import { routeOf } from '../../lib/sites';
import type { PortalConfig, Texts } from '../../lib/types';

interface Props {
  site: string;
  lang: string;
  config: PortalConfig;
  t: Texts;
}
const { site, lang, config, t } = Astro.props;
const { ui } = t;
---

<main class="portal">
  <Img site={site} src={config.background} alt="" class="portal__bg" priority optional />
  <div class="portal__overlay" aria-hidden="true"></div>

  <LangSwitch links={langLinks(lang, routeOf(site))} label={ui.language} class="portal__lang" />

  <div class="portal__content">
    <div class="portal__logo">
      <Img site={site} src={config.logo} alt={ui.logoAlt} sizes="220px" priority />
    </div>

    <h1>{t.title}</h1>
    <p class="portal__subtitle" id="portal-question">{t.subtitle}</p>

    <ul role="list" class="portal__countries" aria-labelledby="portal-question">
      {
        config.countries.map((c) => (
          <li>
            <a href={pathFor(lang, routeOf(c.site))} class="portal__country" aria-label={t.countries[c.site]}>
              <span class="portal__flag">
                <Img site={site} src={c.flag} alt="" sizes="160px" />
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <SocialLinks networks={config.socialOrder} urls={config.social} labels={ui.social} class="portal__social" />
  </div>
</main>

<style>
  .portal {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    display: grid;
    align-items: start;
    justify-items: center;
    padding: clamp(6rem, calc(5.4 * var(--u)), 10.4rem) var(--layout-gutter) 6rem;
    overflow: hidden;
    background: var(--gradient-portal);
  }
  .portal :global(.portal__bg) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .portal__overlay { position: absolute; inset: 0; z-index: -1; background: var(--gradient-portal-overlay); }
  .portal :global(.portal__lang) { position: absolute; top: clamp(2.4rem, calc(5.3 * var(--u)), 10.2rem); right: clamp(1.6rem, calc(5.94 * var(--u)), 11.4rem); }

  .portal__content { display: grid; justify-items: center; text-align: center; }
  .portal__logo { width: clamp(13rem, calc(10.4 * var(--u)), 20rem); }
  .portal__logo :global(img), .portal__logo :global(.img-missing) { width: 100%; height: auto; aspect-ratio: 200 / 210; object-fit: contain; }

  h1 { margin-top: clamp(4rem, calc(4.04 * var(--u)), 7.76rem); font-size: var(--size-portal-title); line-height: 0.928; }
  .portal__subtitle {
    margin-top: clamp(1.6rem, calc(1.63 * var(--u)), 3.13rem);
    font-family: var(--font-heading);
    font-weight: var(--heading-weight);
    text-transform: var(--heading-transform);
    font-size: var(--size-portal-subtitle);
    line-height: 1;
  }

  .portal__countries { display: flex; gap: clamp(2.4rem, calc(2.6 * var(--u)), 5rem); margin-top: clamp(3rem, calc(3.77 * var(--u)), 7.24rem); }
  .portal__country { display: block; border-radius: 50%; }
  .portal__flag {
    display: grid;
    place-items: center;
    width: clamp(10rem, calc(7.8 * var(--u)), 15rem);
    aspect-ratio: 1;
    padding: clamp(0.8rem, calc(0.62 * var(--u)), 1.2rem);
    border-radius: 50%;
    background: var(--color-flag-ring);
    border: 2px solid var(--color-pill-border);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .portal__flag :global(img), .portal__flag :global(.img-missing) {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }
  .portal__flag :global(.img-missing) { font-size: 0.9rem; padding: 0.4rem; }
  .portal__country:hover .portal__flag, .portal__country:focus-visible .portal__flag {
    transform: scale(1.06);
    box-shadow: 0 0 0 4px var(--color-text);
  }

  .portal :global(.portal__social) { margin-top: clamp(4rem, calc(3.25 * var(--u)), 6.25rem); gap: 2.4rem; }
</style>
